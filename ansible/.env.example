# Copy to .env and fill locally. Never commit real secrets.
PVE_SSH_USER=root

# Proxmox API: use an account/token with the required permissions.
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=ansible
PROXMOX_TOKEN_SECRET=
# Needed by the cluster join task in the current community.proxmox interface.
PROXMOX_MASTER_PASSWORD=

# Path to an existing workbook containing the Envir sheet (absolute path recommended).
ENVIR_WORKBOOK=

# These storage/bridge IDs must already exist in Proxmox.
PVE_VM_STORAGE=
PVE_ISO_STORAGE=
PVE_BRIDGE=
WINDOWS_ISO_NAME=
WINDOWS_VIRTIO_ISO_NAME=
UBUNTU_ISO_NAME=

# Set true only after Envir, DHCP/router reservations, IPAM and live conflicts are reviewed.
IP_RESERVATIONS_CONFIRMED=false
WINDOWS_GUEST_IP=
UBUNTU_GUEST_IP=

# Set after guest OS installs and management access is configured.
WINRM_USER=Administrator
WINRM_PASSWORD=
WINRM_PORT=5986
WINRM_CERT_VALIDATION=validate
UBUNTU_SSH_USER=ubuntu
UBUNTU_SSH_KEY=
