# Copy to .env locally and fill in only values needed for your lab.
# Never commit .env or paste secrets into chat.
PVE01_HOST=pve01
PVE02_HOST=pve02
PVE01_IP=192.168.1.111
PVE02_IP=192.168.1.112
PVE_SSH_USER=root
CLUSTER_NAME=

# Required only for guest deployment; obtain all values from your actual LAN/inventory.
# Do not leave example values enabled and do not reuse node addresses.
SUBNET_PREFIX=
GATEWAY=
DNS_SERVERS=
VM_BRIDGE=
PVE_STORAGE=
PVE_ISO_STORAGE=
WINDOWS_ISO=
UBUNTU_ISO=
WINDOWS_VMID=
UBUNTU_VMID=
WINDOWS_GUEST_IP=
UBUNTU_GUEST_IP=
WINDOWS_GUEST_NAME=win-lab01
UBUNTU_GUEST_NAME=ubuntu-lab01
WINDOWS_NODE=
UBUNTU_NODE=
# Proxmox OS type: win10, win11, w2k22, or w2k25.
WINDOWS_OS_TYPE=
WINDOWS_DISK_GIB=
WINDOWS_RAM_MIB=
WINDOWS_VCPU=
UBUNTU_DISK_GIB=
UBUNTU_RAM_MIB=
UBUNTU_VCPU=
GUEST_IP_AVAILABILITY_CONFIRMED=NO
COROSYNC_NETWORK_CONFIRMED=NO

# Proxmox API values for Terraform (recommended to use a least-privilege API token).
PROXMOX_VE_ENDPOINT=
PROXMOX_VE_API_TOKEN=
